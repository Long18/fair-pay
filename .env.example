# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Build-time/server-side Supabase credentials
# Keep SUPABASE_URL aligned with VITE_SUPABASE_URL when runtime version allocation is enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Feature flags (set to "true" to enable)
# VITE_ENABLE_ADMIN_API_DOCS=true

# Donation widget — local dev preview (add to .env.local, do not commit)
# When no donation_settings row exists, dev serves a mock VietQR + bank info automatically.
# Set to true to force the floating widget on even if Supabase has is_enabled=false.
# VITE_DONATION_WIDGET_PREVIEW=true
# VITE_DONATION_PREVIEW_AMOUNT=50000
# VITE_DONATION_PREVIEW_QR_URL=https://…
# VITE_ADMIN_EMAIL=you@example.com

# Bank / MoMo receive settings — local dev preview (add to .env.local, do not commit)
# When user_settings has no bank_info/momo_info, dev can prefill sample VietQR + MoMo fields.
# Banner shows on /settings/bank and /settings/momo whenever preview is not disabled in dev.
# Set to true to force prefill when DB is empty (required for form + QR preview without saving).
# VITE_BANK_SETTINGS_PREVIEW=true
# VITE_BANK_PREVIEW_BANK_CODE=VCB
# VITE_BANK_PREVIEW_ACCOUNT=19036588880123
# VITE_BANK_PREVIEW_ACCOUNT_NAME=NGUYEN VAN FAIRPAY (LOCAL)
# VITE_BANK_PREVIEW_MOMO_PHONE=0901234567
# VITE_BANK_PREVIEW_MOMO_NAME=NGUYEN VAN FAIRPAY (LOCAL)
# VITE_BANK_PREVIEW_VIETQR_URL=https://…
# VITE_BANK_PREVIEW_MOMO_QR_URL=https://placehold.co/240x240/png?text=MoMo+QR
# Real save needs user_settings.bank_info / momo_info columns — apply migrations locally:
#   pnpm db:local:bootstrap   # or: pnpm supabase db push (remote)

# Polar (FairPay Pro subscriptions) — SePay remains expense-settle only
# Create product + webhook in https://polar.sh dashboard
# VITE_POLAR_PRODUCT_ID=                       # optional client display
# POLAR_ACCESS_TOKEN=                          # Polar organization access token
# POLAR_WEBHOOK_SECRET=                        # webhook signing secret
# POLAR_PRODUCT_ID=                            # Pro product id for checkout
# POLAR_SERVER=sandbox                         # sandbox | production
# SITE_URL=http://localhost:3000               # success/return URL base

