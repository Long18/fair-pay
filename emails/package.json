  },
  "devDependencies": {
    "@react-email/ui": "6.11.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^6.0.3"
  }
