# Pay2S OAuth integration (Supabase Edge Function secrets — server-side only)
# Set with: supabase secrets set --env-file <file>   (never commit real values)
# Docs: https://developer.pay2s.vn/docs/oauth/overview/

# From Pay2S developer portal -> "Ung dung cua toi". One app per environment
# (an app has exactly one HTTPS callback, no wildcards).
PAY2S_CLIENT_ID=your_client_id
PAY2S_CLIENT_SECRET=your_client_secret

# Must exactly equal the callback registered on the Pay2S app (HTTPS, port 443):
# https://<project-ref>.supabase.co/functions/v1/pay2s-oauth-callback
PAY2S_REDIRECT_URI=https://your-project.supabase.co/functions/v1/pay2s-oauth-callback

# 32 random bytes, base64. Generate: openssl rand -base64 32
PAY2S_TOKEN_ENCRYPTION_KEY=

# Where the browser returns after the OAuth round trip (also used for CORS)
APP_URL=https://your-app.example.com

# Optional overrides (local mock server / tunnels)
# PAY2S_API_BASE=https://api.pay2s.vn/api/v1/oauth
# PAY2S_ISSUER=https://api.pay2s.vn
# PAY2S_WEBHOOK_BASE_URL=https://<public-https-host>/functions/v1
